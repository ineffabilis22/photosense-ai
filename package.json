{
  "name": "photosense-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/start.mjs",
    "build": "tsc -b && vite build",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "check": "npm run test:typecheck && npm run test && npm run build",
    "preview": "vite preview",
    "start": "node server/start.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^25.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
