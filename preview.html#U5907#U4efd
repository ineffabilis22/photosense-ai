    <script>
      const genres = ['街头摄影', '人像摄影', '风景摄影', '建筑摄影', '静物摄影', '旅行摄影', '胶片摄影'];
      const skillLevels = ['初学者', '进阶', '高级'];
      const scoreNames = ['构图', '光线', '色彩', '叙事', '技术完成度'];
      const skillTooltips = {
        初学者: '更基础、更易懂，更强调拍摄习惯、取景方式与下一次可以尝试的具体动作。',
        进阶: '加入更多构图、光线、色彩和画面组织判断，帮助你从“拍到”走向“拍准”。',
        高级: '更强调叙事、风格、视觉语言与作者意图，反馈会更接近作品集编辑视角。',
      };
      const genreGuidance = {
        街头摄影: '街头摄影的力量通常来自时机、人物姿态与现场秩序之间的张力。',
        人像摄影: '人像作品首先需要建立观看关系：表情、眼神、肤色、背景克制感都会影响画面的可信度。',
        风景摄影: '风景摄影更依赖空间层次、空气感、明暗分离，以及画面能否为视线安排一条自然路径。',
        建筑摄影: '建筑影像需要严谨的边线、透视控制、结构节奏，以及能勾勒体块关系的光线。',
        静物摄影: '静物摄影看似安静，但真正的判断来自材质、阴影形状、物件关系和留白比例。',
        旅行摄影: '旅行摄影不只是记录地点，更要让地方气质、人的痕迹和视觉秩序同时成立。',
        胶片摄影: '胶片摄影可以保留颗粒、偏色和不完美，但这些质感需要服务于情绪，而不是替代画面判断。',
      };
      const levelGuidance = {
        初学者: '建议先把注意力放在一个明确目标上：让主体更清楚、边缘更干净、最亮处更有控制。',
        进阶: '你已经具备一定画面控制力，可以进一步关注主体分离、边缘管理和局部明暗关系。',
        高级: '这个阶段的重点不再是单项正确，而是每个视觉决定是否共同指向清晰的作者意图。',
      };

      let selectedGenre = '街头摄影';
      let selectedLevel = '初学者';
      let imageUrl = '';
      let reportText = '';
      let timer = null;

      const input = document.querySelector('#photo-input');
      const choosePhoto = document.querySelector('#choose-photo');
      const previewStage = document.querySelector('#preview-stage');
      const fileName = document.querySelector('#file-name');
      const uploadStatus = document.querySelector('#upload-status');
      const metadataGenre = document.querySelector('#metadata-genre');
      const frameGenre = document.querySelector('#frame-genre');
      const metadataLevel = document.querySelector('#metadata-level');
      const metadataDate = document.querySelector('#metadata-date');
      const previewTitle = document.querySelector('#preview-title');
      const analyzeButton = document.querySelector('#analyze-button');
      const resetButton = document.querySelector('#reset-button');
      const copyButton = document.querySelector('#copy-report');
      const reportOutput = document.querySelector('#report-output');
      const skillTooltip = document.querySelector('#skill-tooltip');
      const pageViews = document.querySelectorAll('[data-page-view]');
      const pageLinks = document.querySelectorAll('[data-page-link]');

      function showPage(page) {
        pageViews.forEach((view) => {
          view.hidden = view.dataset.pageView !== page;
        });

        pageLinks.forEach((link) => {
          if (link.closest('.nav-links') || link.closest('.header-actions')) {
            link.classList.toggle('active', link.dataset.pageLink === page);
          }
        });

        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      document.addEventListener('click', (event) => {
        const pageLink = event.target.closest('[data-page-link]');

        if (!pageLink) {
          return;
        }

        event.preventDefault();
        showPage(pageLink.dataset.pageLink);
      });

      metadataDate.textContent = new Intl.DateTimeFormat('zh-CN', {
        month: 'long',
        day: 'numeric',
        year: 'numeric',
      }).format(new Date());

      function buildChoices() {
        document.querySelector('#genre-options').innerHTML = genres
          .map((genre, index) => {
            const stateClass = genre === selectedGenre ? 'active' : '';
            return `<button class="genre-button genre-${index + 1} ${stateClass}" type="button" data-genre="${genre}"><span>${genre}</span></button>`;
          })
          .join('');

        document.querySelector('#level-options').innerHTML = skillLevels
          .map(
            (level) =>
              `<button class="level-button ${level === selectedLevel ? 'active' : ''}" type="button" data-level="${level}">${level}</button>`,
          )
          .join('');
      }

      function showSkillTooltip(level, event) {
        skillTooltip.textContent = skillTooltips[level];
        skillTooltip.style.left = `${event.clientX + 18}px`;
        skillTooltip.style.top = `${event.clientY + 18}px`;
        skillTooltip.hidden = false;
      }

      function createReport() {
        const shift = selectedLevel === '初学者' ? -3 : selectedLevel === '高级' ? 4 : 0;
        const scores = {
          构图: 78 + shift,
          光线: 74 + shift,
          色彩: 81 + shift,
          叙事: 76 + shift,
          技术完成度: 83 + shift,
        };
        const recipe = {
          曝光: '+0.20',
          对比度: '+12',
          高光: '-18',
          阴影: '+10',
          色温: selectedGenre === '胶片摄影' ? '+4 偏暖' : '+2 偏暖',
          裁切比例: selectedGenre === '人像摄影' ? '4:5 竖幅' : selectedGenre === '建筑摄影' ? '5:4 精准裁切' : '3:2 编辑裁切',
        };
        const suggestions = [
          '拍摄时先确认一个不可替代的主体，再通过靠近、降低机位或等待姿态变化来强化它。',
          '处理画面边缘，把最不重要的一侧压暗、裁掉或简化，让注意力留在照片内部。',
          '后期先用明暗关系引导视线，再决定是否增加对比和饱和度，避免一开始就做过重的整体调色。',
        ];

        const overall = `${genreGuidance[selectedGenre]} 当前画面已经有可读的视觉核心，下一步应强化观看顺序：先让主体更快被识别，再保留次要信息作为层次。${levelGuidance[selectedLevel]}`;
        const composition = `结论：主体区域已成立，但边缘仍有干扰。说明：${selectedGenre}需要更清楚的视觉入口。方向：收紧裁切或移动机位，让主体和留白关系更稳定。`;
        const lighting =
          '结论：光线方向可读，但中间调还不够集中。说明：高光已能引导视线，暗部需要保留层次。方向：轻微回收高光，并用局部提亮托出主体。';
        const colour =
          '结论：色彩克制，有形成情绪的基础。说明：冷暖关系可以更明确。方向：保护中性色，只让一个关键色承担视觉记忆点。';
        const storytelling = `结论：画面有瞬间感，但叙事指向还可再清楚。说明：${selectedLevel}阶段应先确定观众读到的第一件事。方向：减少延迟理解的元素，保留必要余味。`;
        const technical = '结论：技术完成度稳定。说明：清晰度、曝光和整体质感足以支撑点评。方向：继续用局部调整替代大幅全局滤镜。';
        suggestions[0] = '收紧裁切，让主体进入更明确的位置。';
        suggestions[1] = '压低边缘干扰，让视线留在画面内部。';
        suggestions[2] = '局部提亮主体，再决定整体对比度。';

        reportText = `PhotoSense AI 摄影评审报告\n类型：${selectedGenre}\n创作阶段：${selectedLevel}\n\n总体印象\n${overall}\n\n评分\n${scoreNames
          .map((name) => `${name}：${scores[name]}/100`)
          .join('\n')}\n\n构图分析\n${composition}\n\n光线分析\n${lighting}\n\n色彩分析\n${colour}\n\n叙事分析\n${storytelling}\n\n技术完成度\n${technical}\n\n三条可执行建议\n${suggestions
          .map((item, index) => `${index + 1}. ${item}`)
          .join('\n')}\n\n建议后期配方\n${Object.entries(recipe)
          .map(([key, value]) => `${key}：${value}`)
          .join('\n')}`;

        const cards = [
          ['构图', composition],
          ['光线', lighting],
          ['色彩', colour],
          ['叙事', storytelling],
          ['技术完成度', technical],
        ];
        const demos = [
          ['原裁切', '收紧主体', 'demo-crop'],
          ['边缘分散', '压低边缘', 'demo-edge'],
          ['主体偏暗', '局部提亮', 'demo-light'],
        ];

        function part(text, start, end) {
          const result = text.match(new RegExp(`${start}：(.+?)${end ? `。${end}：` : '$'}`));
          return result ? result[1] : text;
        }

        return `
          <div class="diagnostic-report">
            <section class="diagnostic-hero-report" aria-label="照片诊断标注">
              <div class="diagnostic-image-board">
                ${imageUrl ? `<img src="${imageUrl}" alt="用于诊断的已上传照片" />` : ''}
                <span class="image-callout callout-one">主体锚点</span>
                <span class="image-callout callout-two">高光引导</span>
                <span class="image-callout callout-three">边缘干扰</span>
              </div>
              <article class="diagnostic-overview">
                <div class="report-title-row"><span class="section-icon"><svg viewBox="0 0 24 24"><path d="M4 12h4l2-5 4 10 2-5h4" /></svg></span><div><p class="panel-kicker">总体判断</p><h3>先建立观看顺序，再保留画面余味</h3></div></div>
                <p>${overall}</p>
                <dl><div><dt>摄影风格</dt><dd>${selectedGenre}</dd></div><div><dt>点评口径</dt><dd>${selectedLevel}</dd></div><div><dt>报告日期</dt><dd>${metadataDate.textContent}</dd></div></dl>
              </article>
            </section>
            <section class="score-sheet" aria-label="摄影评分">
              <div class="report-title-row"><span class="section-icon"><svg viewBox="0 0 24 24"><path d="M4 17h16 M6 17V8 M12 17V5 M18 17v-7" /></svg></span><div><p class="panel-kicker">评分表</p><h3>五项摄影诊断维度</h3></div></div>
              <div class="score-strip">${scoreNames.map((name) => `<div class="score-item"><span>${name}</span><strong>${scores[name]}</strong><div class="score-rule"><span style="width:${scores[name]}%"></span></div></div>`).join('')}</div>
            </section>
            <section class="diagnosis-grid" aria-label="分析模块">${cards
              .map(
                ([title, text]) =>
                  `<article class="diagnostic-card"><div class="report-title-row"><span class="section-icon"><svg viewBox="0 0 24 24"><path d="M5 5h14v14H5z M9 5v14 M15 5v14 M5 9h14 M5 15h14" /></svg></span><div><p class="panel-kicker">诊断模块</p><h3>${title}</h3></div></div><dl><div><dt>结论</dt><dd>${part(text, '结论', '说明')}</dd></div><div><dt>说明</dt><dd>${part(text, '说明', '方向')}</dd></div><div><dt>方向</dt><dd>${part(text, '方向')}</dd></div></dl></article>`,
              )
              .join('')}</section>
            <section class="visual-suggestions" aria-label="可执行建议">
              <div class="report-title-row"><span class="section-icon"><svg viewBox="0 0 24 24"><path d="M12 4v6 M12 14v6 M4 12h6 M14 12h6 M7 7l3 3 M14 14l3 3" /></svg></span><div><p class="panel-kicker">行动建议</p><h3>三组可视化修改方向</h3></div></div>
              <div class="suggestion-grid">${suggestions
                .map((item, index) => `<article class="suggestion-card"><div class="suggestion-copy"><span>${String(index + 1).padStart(2, '0')}</span><p>${item}</p></div><div class="mini-demo ${demos[index][2]}"><div><em>${demos[index][0]}</em></div><div><em>${demos[index][1]}</em></div></div></article>`)
                .join('')}</div>
            </section>
            <section class="edit-recipe-sheet">
              <div class="report-title-row"><span class="section-icon"><svg viewBox="0 0 24 24"><path d="M7 4h10v16H7z M10 8h4 M10 12h4 M10 16h2" /></svg></span><div><p class="panel-kicker">后期参考</p><h3>暗房式调整记录</h3></div></div>
              <div class="recipe-board">${Object.entries(recipe).map(([key, value], index) => `<div class="recipe-item"><div><span>${key}</span><strong>${value}</strong></div><div class="recipe-track" aria-hidden="true"><i style="width:${[56, 64, 38, 58, 62, 72][index]}%"></i></div></div>`).join('')}</div>
            </section>
          </div>`;
      }

      choosePhoto.addEventListener('click', () => input.click());
      input.addEventListener('change', () => {
        const file = input.files[0];
        if (!file) return;
        if (imageUrl) URL.revokeObjectURL(imageUrl);
        clearTimeout(timer);
        imageUrl = URL.createObjectURL(file);
        fileName.textContent = file.name;
        uploadStatus.textContent = '已上传';
        previewStage.classList.add('has-image');
        previewStage.innerHTML = `<img src="${imageUrl}" alt="已上传照片预览" />`;
        previewTitle.textContent = '作品已进入点评流程';
        analyzeButton.disabled = false;
        reportOutput.className = 'empty-report';
        reportOutput.innerHTML = '<p>作品已载入。点击分析照片后将生成评审单。</p>';
        copyButton.hidden = true;
      });

      document.addEventListener('click', (event) => {
        const genreButton = event.target.closest('[data-genre]');
        const levelButton = event.target.closest('[data-level]');
        const genre = genreButton?.dataset.genre;
        const level = levelButton?.dataset.level;
        if (genre) selectedGenre = genre;
        if (level) selectedLevel = level;
        if (genre || level) {
          metadataGenre.textContent = selectedGenre;
          frameGenre.textContent = selectedGenre;
          metadataLevel.textContent = selectedLevel;
          buildChoices();
          copyButton.hidden = true;
          reportOutput.className = 'empty-report';
          reportOutput.innerHTML = '<p>评审条件已更新。重新分析后会生成新的评审单。</p>';
        }
      });

      document.addEventListener('mousemove', (event) => {
        const level = event.target.closest('[data-level]')?.dataset.level;
        if (level) showSkillTooltip(level, event);
      });

      document.addEventListener('mouseover', (event) => {
        const level = event.target.closest('[data-level]')?.dataset.level;
        if (level) showSkillTooltip(level, event);
      });

      document.addEventListener('mouseout', (event) => {
        if (event.target.closest('[data-level]')) skillTooltip.hidden = true;
      });

      analyzeButton.addEventListener('click', () => {
        if (!imageUrl) return;
        analyzeButton.disabled = true;
        analyzeButton.textContent = '正在分析影像';
        copyButton.hidden = true;
        reportOutput.className = 'loading-panel';
        reportOutput.innerHTML = '<div class="scan-line"></div><p>正在读取明暗结构、主体层级与画面意图。</p>';
        timer = setTimeout(() => {
          reportOutput.className = '';
          reportOutput.innerHTML = createReport();
          analyzeButton.disabled = false;
          analyzeButton.textContent = '开始分析';
          copyButton.hidden = false;
          showPage('report');
        }, 900);
      });

      copyButton.addEventListener('click', async () => {
        try {
          if (navigator.clipboard) {
            await navigator.clipboard.writeText(reportText);
          } else {
            const copyArea = document.createElement('textarea');
            copyArea.value = reportText;
            document.body.appendChild(copyArea);
            copyArea.select();
            document.execCommand('copy');
            document.body.removeChild(copyArea);
          }
          copyButton.textContent = '已复制';
        } catch {
          copyButton.textContent = '复制失败';
        }
        setTimeout(() => {
          copyButton.textContent = '复制报告';
        }, 1600);
      });

      resetButton.addEventListener('click', () => {
        clearTimeout(timer);
        if (imageUrl) URL.revokeObjectURL(imageUrl);
        imageUrl = '';
        input.value = '';
        selectedGenre = '街头摄影';
        selectedLevel = '初学者';
        fileName.textContent = '等待选择影像文件';
        uploadStatus.textContent = '尚未选择文件';
        metadataGenre.textContent = selectedGenre;
        frameGenre.textContent = selectedGenre;
        metadataLevel.textContent = selectedLevel;
        previewTitle.textContent = '请先上传一张照片';
        previewStage.classList.remove('has-image');
        previewStage.innerHTML = '<div class="empty-preview light-table-empty"><span>待审</span><p>上传后会在灯台区域生成大图预览</p></div>';
        analyzeButton.disabled = true;
        analyzeButton.textContent = '开始分析';
        copyButton.hidden = true;
        reportOutput.className = 'empty-report';
        reportOutput.innerHTML = '<p>上传照片并开始分析后，这里会生成第一份影像评审单。</p>';
        buildChoices();
      });

      buildChoices();
      showPage('home');
    </script>
  </body>
</html>
