# PhotoSense AI deployment environment variables
# Copy these names into Render / Railway / other platform Environment Variables.
# Do not put real keys in GitHub.

# Shared OpenAI-compatible relay used by the automatic report fallback route.
REPORT_RELAY_BASE_URL=https://kuaipao.pro/v1
REPORT_RELAY_API_KEY=replace_with_your_relay_api_key
REPORT_MODEL_GPT=gpt-5.6-luna
REPORT_MODEL_CLAUDE=claude-sonnet-5
REPORT_MODEL_DEEPSEEK=deepseek-v4.1-flash
REPORT_MODEL_GEMINI=gemini-3-flash

# The image relay may reuse REPORT_RELAY_API_KEY when the same relay serves both APIs.
# GPT Image is attempted first, followed by the other available image models.
IMAGE_RELAY_BASE_URL=https://kuaipao.pro/v1
IMAGE_RELAY_API_KEY=
IMAGE_MODEL_GPT=gpt-image-2
IMAGE_MODEL_NANO_BANANA=nano-banana-2
IMAGE_MODEL_GROK_IMAGE=grok-image

# Backward-compatible aliases. Existing deployments can keep these during migration.
OPENAI_RELAY_BASE_URL=https://kuaipao.pro/v1
OPENAI_RELAY_API_KEY=
OPENAI_RELAY_MODEL=gpt-5.6-luna
IMAGE_RELAY_MODEL=gpt-image-2

# Optional tuning
PROVIDER_TIMEOUT_MS=60000
OPENAI_RELAY_TIMEOUT_MS=90000
PREVIEW_RENDER_TIMEOUT_MS=15000
OPENAI_RELAY_MAX_TOKENS=3000
OPENAI_RELAY_TEMPERATURE=0.2
IMAGE_RELAY_TIMEOUT_MS=120000

# Local development export only. Keep both false on public deployments.
ENABLE_HISTORY_EXPORT=false
VITE_ENABLE_HISTORY_EXPORT=false
NODE_ENV=production
