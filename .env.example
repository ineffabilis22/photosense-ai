# PhotoSense AI deployment environment variables
# Copy these names into Render / Railway / other platform Environment Variables.
# Do not put real keys in GitHub.

OPENAI_RELAY_BASE_URL=https://kuaipao.pro/v1
OPENAI_RELAY_API_KEY=replace_with_your_relay_api_key
OPENAI_RELAY_MODEL=gpt-5.4

# Optional tuning
PROVIDER_TIMEOUT_MS=60000
OPENAI_RELAY_TIMEOUT_MS=90000
PREVIEW_RENDER_TIMEOUT_MS=15000
OPENAI_RELAY_MAX_TOKENS=3000
OPENAI_RELAY_TEMPERATURE=0.2

# Local development export only. Keep both false on public deployments.
ENABLE_HISTORY_EXPORT=false
VITE_ENABLE_HISTORY_EXPORT=false
NODE_ENV=production
